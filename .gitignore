# Only track the review 1 folder and the top-level docs — everything else
# (meeting notes, archive, old research PDFs) stays local, out of the repo.
*

!/review 1/
!/review 1/**
!/README.md
!/.gitignore

# LaTeX build artifacts, even inside tracked folders
*.aux
*.log
*.out
*.nav
*.snm
*.toc
*.fdb_latexmk
*.fls
*.vrb
*.synctex.gz
compile_log.txt

# OS junk
.DS_Store
Thumbs.db
